---
/**
 * Zwei-Klick-Lösung: Zuerst nur ein lokales Vorschaubild + Hinweis.
 * Erst nach Klick wird das Video über youtube-nocookie.com geladen.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  videoId: string;
  title: string;
  poster: ImageMetadata;
  posterAlt: string;
  locale: Locale;
}

const { videoId, title, poster, posterAlt, locale } = Astro.props;
const t = useTranslations(locale);
const isPlaceholder = videoId === 'PLATZHALTER';
---

<div class="yt" data-yt data-video-id={videoId} data-title={title}>
  <Image
    class="yt__poster"
    src={poster}
    alt={posterAlt}
    widths={[640, 960, 1280, 1920]}
    sizes="(min-width: 76rem) 76rem, 100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="yt__overlay">
    <button class="yt__play" type="button" data-yt-load disabled={isPlaceholder}>
      <span class="yt__icon" aria-hidden="true"></span>
      <span>{isPlaceholder ? 'Showreel folgt' : t('youtube.load')}</span>
    </button>
    <p class="yt__notice">
      {t('youtube.notice')}
      <a href={localizePath('privacy', locale)}>{t('youtube.privacyLink')}</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-yt-load]');
    button?.addEventListener('click', () => {
      const id = encodeURIComponent(root.dataset.videoId ?? '');
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = root.dataset.title ?? 'YouTube-Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'yt__frame';
      root.replaceChildren(iframe);
      root.classList.add('is-loaded');
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-inverse-bg);
  }
  .yt__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .yt__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: linear-gradient(to top, rgb(20 22 23 / 0.75), rgb(20 22 23 / 0.15));
    color: #fff;
    text-align: center;
  }
  .yt__play {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 999px;
    background: rgb(20 22 23 / 0.35);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    backdrop-filter: blur(4px);
    transition: background var(--duration) var(--ease);
  }
  .yt__play:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.15);
  }
  .yt__play:disabled {
    cursor: default;
    opacity: 0.8;
  }
  .yt__play:focus-visible,
  .yt__notice a:focus-visible {
    outline-color: #fff;
  }
  .yt__icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent currentColor;
  }
  .yt__notice {
    max-width: 52ch;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }
  .yt__notice a {
    color: #fff;
  }
  @media (max-width: 36em) {
    .yt {
      aspect-ratio: 4 / 3;
    }
  }
  .yt :global(.yt__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt:global(.is-loaded) {
    aspect-ratio: 16 / 9;
  }
</style>
