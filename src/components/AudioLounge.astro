---
/**
 * Audio-Lounge: Kategorien als Tabs, eigener HTML5-Player im Seitendesign.
 * Es läuft immer nur eine Hörprobe gleichzeitig.
 * Ohne JavaScript werden alle Kategorien untereinander mit nativen Playern gezeigt.
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  samples: CollectionEntry<'audio'>[];
  locale: Locale;
  headingId: string;
}

const { samples, locale, headingId } = Astro.props;
const t = useTranslations(locale);
const categories = ['gesang', 'bayerisch', 'hoerbuch', 'werbung'] as const;
const groups = categories.map((category) => ({
  category,
  label: t(`audio.category.${category}`),
  items: samples
    .filter((s) => s.data.category === category)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
}));
---

{
  samples.length === 0 && (
    <div class="lounge-soon">
      <p>{t('audio.soon')}</p>
      <ul>
        {groups.map((g) => (
          <li>{g.label}</li>
        ))}
      </ul>
    </div>
  )
}

{samples.length > 0 && (
<div class="lounge" data-lounge>
  <div class="lounge__tabs" role="tablist" aria-label={t('audio.tabsLabel')} aria-describedby={headingId} hidden data-tablist>
    {
      groups.map((g, i) => (
        <button
          class="lounge__tab"
          type="button"
          role="tab"
          id={`tab-${g.category}`}
          aria-controls={`panel-${g.category}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab
        >
          {g.label}
          <span class="lounge__count">{g.items.length}</span>
        </button>
      ))
    }
  </div>

  {
    groups.map((g) => (
      <section class="lounge__panel" id={`panel-${g.category}`} aria-labelledby={`tab-${g.category}`} data-panel>
        <h3 class="lounge__panel-title" data-panel-title>
          {g.label}
        </h3>
        {g.items.length === 0 ? (
          <p class="muted">{t('audio.empty')}</p>
        ) : (
          <ul class="tracks">
            {g.items.map(({ data }) => (
              <li class="track" data-track>
                <audio src={data.file} preload="metadata" controls data-audio />
                <button class="track__play" type="button" aria-label={`${t('audio.play')}: ${data.title}`} data-play hidden
                  data-label-play={`${t('audio.play')}: ${data.title}`}
                  data-label-pause={`${t('audio.pause')}: ${data.title}`}>
                  <span class="track__icon" aria-hidden="true" />
                </button>
                <div class="track__body">
                  <p class="track__title">{data.title}</p>
                  <p class="track__meta">
                    {data.languages.map((l) => (
                      <span class="track__lang">{t(`audio.lang.${l}`)}</span>
                    ))}
                    {data.description && <span class="track__desc">{data.description}</span>}
                  </p>
                  <div class="track__controls" hidden data-controls>
                    <input
                      class="track__seek"
                      type="range"
                      min="0"
                      max="100"
                      step="0.1"
                      value="0"
                      aria-label={`${t('audio.seek')}: ${data.title}`}
                      data-seek
                    />
                    <span class="track__time" data-time>
                      0:00
                    </span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>
)}

<script>
  const fmt = (s: number) => {
    if (!Number.isFinite(s)) return '–:–';
    const m = Math.floor(s / 60);
    return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };

  // Immer nur eine Hörprobe gleichzeitig (gilt für alle <audio> der Seite).
  document.addEventListener(
    'play',
    (e) => {
      document.querySelectorAll('audio').forEach((a) => a !== e.target && a.pause());
    },
    true,
  );

  document.querySelectorAll<HTMLElement>('[data-lounge]').forEach((root) => {
    /* ---------- Tabs ---------- */
    const tablist = root.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (tablist && tabs.length) {
      tablist.hidden = false;
      root.classList.add('is-enhanced');
      panels.forEach((p, i) => {
        p.setAttribute('role', 'tabpanel');
        p.tabIndex = 0;
        p.hidden = i !== 0;
      });
      const select = (index: number, focus = true) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[i].hidden = !active;
        });
        if (focus) tabs[index].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i, false));
        tab.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          const map: Record<string, number> = {
            ArrowRight: i === last ? 0 : i + 1,
            ArrowLeft: i === 0 ? last : i - 1,
            Home: 0,
            End: last,
          };
          if (e.key in map) {
            e.preventDefault();
            select(map[e.key]);
          }
        });
      });
    }

    /* ---------- Player ---------- */
    root.querySelectorAll<HTMLElement>('[data-track]').forEach((track) => {
      const audio = track.querySelector<HTMLAudioElement>('[data-audio]');
      const play = track.querySelector<HTMLButtonElement>('[data-play]');
      const controls = track.querySelector<HTMLElement>('[data-controls]');
      const seek = track.querySelector<HTMLInputElement>('[data-seek]');
      const time = track.querySelector<HTMLElement>('[data-time]');
      if (!audio || !play || !controls || !seek || !time) return;

      audio.controls = false;
      play.hidden = false;
      controls.hidden = false;

      const update = () => {
        const d = audio.duration;
        const pct = Number.isFinite(d) && d > 0 ? (audio.currentTime / d) * 100 : 0;
        seek.value = String(pct);
        seek.style.setProperty('--progress', `${pct}%`);
        const label = `${fmt(audio.currentTime)} / ${fmt(d)}`;
        time.textContent = label;
        seek.setAttribute('aria-valuetext', label);
      };
      const setState = (playing: boolean) => {
        track.classList.toggle('is-playing', playing);
        play.setAttribute('aria-label', (playing ? play.dataset.labelPause : play.dataset.labelPlay) ?? '');
      };

      play.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
      audio.addEventListener('play', () => setState(true));
      audio.addEventListener('pause', () => setState(false));
      audio.addEventListener('ended', () => {
        setState(false);
        audio.currentTime = 0;
      });
      audio.addEventListener('timeupdate', update);
      audio.addEventListener('loadedmetadata', update);
      audio.addEventListener('durationchange', update);
      seek.addEventListener('input', () => {
        if (Number.isFinite(audio.duration)) audio.currentTime = (Number(seek.value) / 100) * audio.duration;
        update();
      });
      if (audio.readyState >= 1) update();
    });
  });
</script>

<style>
  .lounge-soon {
    padding: var(--space-lg);
    border: var(--border);
    border-radius: var(--radius);
  }
  .lounge-soon p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .lounge-soon ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }
  .lounge-soon li {
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-family: var(--font-serif);
  }
  .lounge__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    border-bottom: var(--border);
    margin-bottom: var(--space-lg);
  }
  .lounge__tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.85rem 0;
    border: 0;
    background: none;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    transition: color var(--duration) var(--ease);
  }
  .lounge__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform var(--duration) var(--ease);
  }
  .lounge__tab:hover,
  .lounge__tab[aria-selected='true'] {
    color: var(--color-heading);
  }
  .lounge__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }
  .lounge__count {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .lounge__panel + .lounge__panel {
    margin-top: var(--space-xl);
  }
  .is-enhanced .lounge__panel + .lounge__panel {
    margin-top: 0;
  }
  .lounge__panel-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
  }
  .is-enhanced .lounge__panel-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .lounge__panel:focus-visible {
    outline-offset: 6px;
  }

  .tracks {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }
  .track {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius);
    transition: border-color var(--duration) var(--ease);
  }
  .track.is-playing {
    border-color: var(--color-accent);
  }
  .track audio {
    grid-column: 1 / -1;
    width: 100%;
  }
  .track__play {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: transparent;
    color: var(--color-accent);
    transition: background var(--duration) var(--ease), color var(--duration) var(--ease);
  }
  .track__play:hover,
  .is-playing .track__play {
    background: var(--color-accent);
    color: #fff;
  }
  .track__icon {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent currentColor;
  }
  .is-playing .track__icon {
    width: 11px;
    height: 14px;
    margin-left: 0;
    border-width: 0 3.5px;
    border-color: currentColor;
  }
  .track__body {
    min-width: 0;
  }
  .track__title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }
  .track__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .track__lang {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .track__controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .track__time {
    flex: none;
    min-width: 5.5rem;
    text-align: right;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  /* Fortschrittsbalken */
  .track__seek {
    --progress: 0%;
    flex: 1;
    min-width: 0;
    height: 1.5rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  .track__seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(to right, var(--color-accent) var(--progress), var(--color-line-strong) var(--progress));
  }
  .track__seek::-moz-range-track {
    height: 2px;
    background: var(--color-line-strong);
  }
  .track__seek::-moz-range-progress {
    height: 2px;
    background: var(--color-accent);
  }
  .track__seek::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 0;
  }
  .track__seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 0;
  }

  @media (min-width: 40em) {
    .track {
      padding: var(--space-md) var(--space-lg);
      gap: var(--space-lg);
    }
  }
</style>
