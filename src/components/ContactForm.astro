---
/**
 * Kontaktformular über Netlify Forms.
 * - Honeypot-Feld "bot-field" (netlify-honeypot) als Spamschutz
 * - Pflicht-Checkbox Datenschutz
 * - Vorauswahl des Anliegens per URL-Parameter, z. B. ?anliegen=lektorat
 */
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const topics = ['lektorat', 'stoffentwicklung', 'sprechen', 'sonstiges'] as const;
---

<form
  class="contact-form"
  name="kontakt"
  method="POST"
  action={localizePath('thanks', locale)}
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
>
  <input type="hidden" name="form-name" value="kontakt" />
  <input type="hidden" name="subject" value="Neue Anfrage über die Website" />

  <p class="contact-form__hp" aria-hidden="true">
    <label>
      {t('contact.honeypot')}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="field">
    <label for="cf-topic">{t('contact.topic')} <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-topic" name="anliegen" required data-topic>
      <option value="">{t('contact.topic.choose')}</option>
      {topics.map((topic) => <option value={topic}>{t(`contact.topic.${topic}`)}</option>)}
    </select>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="cf-name">{t('contact.name')} <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-email">{t('contact.email')} <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  <div class="field">
    <label for="cf-message">{t('contact.message')} <span class="req" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="nachricht" rows="7" required></textarea>
  </div>

  <div class="field field--check">
    <input id="cf-privacy" name="datenschutz" type="checkbox" value="akzeptiert" required />
    <label for="cf-privacy">
      {t('contact.privacy.before')}
      <a href={localizePath('privacy', locale)}>{t('contact.privacy.link')}</a>
      {t('contact.privacy.after')} <span class="req" aria-hidden="true">*</span>
    </label>
  </div>

  <p class="contact-form__hint">
    <span aria-hidden="true">*</span>
    {t('contact.required')}
  </p>

  <button class="button" type="submit">{t('contact.submit')}</button>
</form>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-topic]');
  const topic = new URLSearchParams(window.location.search).get('anliegen');
  if (select && topic && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-md);
  }
  .contact-form__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field-row {
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 40em) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .req {
    color: var(--color-accent);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color var(--duration) var(--ease);
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-text) 50%),
      linear-gradient(135deg, var(--color-text) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 55%,
      calc(100% - 0.9rem) 55%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }
  textarea {
    resize: vertical;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--color-text-muted);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }
  input:user-invalid,
  select:user-invalid,
  textarea:user-invalid {
    border-color: var(--color-error);
  }
  .field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-sm);
  }
  .field--check input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--color-accent);
  }
  .field--check label {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .contact-form__hint {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .contact-form .button {
    justify-self: start;
  }
</style>
