---
import { defaultLocale, type Locale } from '../i18n/config';
import { localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import type { Settings } from '../lib/content';
import { legalNav, mainNav } from '../lib/navigation';

interface Props {
  locale: Locale;
  settings: Settings;
}

const { locale, settings } = Astro.props;
const t = useTranslations(locale);
// Die Unterzeile ist im CMS (Deutsch) pflegbar, für EN/FR kommt sie aus ui.ts.
const tagline = locale === defaultLocale ? settings.tagline : t('brand.tagline');
const year = new Date().getFullYear();
const info = settings.emails.find((e) => e.key === 'info') ?? settings.emails[0];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__name" href={localizePath('home', locale)}>{settings.siteName}</a>
      <p>{tagline}</p>
      {info && <p><a href={`mailto:${info.address}`}>{info.address}</a></p>}
      {
        settings.agency.email && (
          <p class="site-footer__agency">
            <span>{t('footer.acting')}:</span>
            <br />
            {settings.agency.name} ·{' '}
            <a href={`mailto:${settings.agency.email}`}>{settings.agency.email}</a>
          </p>
        )
      }
    </div>

    <nav aria-label={t('nav.label')}>
      <ul class="site-footer__list">
        {
          mainNav.map((key) => (
            <li>
              <a href={localizePath(key, locale)}>{t(`nav.${key}`)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__heading">{t('nav.profiles')}</h2>
      <ul class="site-footer__list">
        {
          settings.profiles.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener">
                {p.label}
                <span class="visually-hidden"> {t('common.externalLink')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {settings.siteName}</p>
    <nav aria-label={t('footer.legal')}>
      <ul class="site-footer__legal">
        {
          legalNav.map((key) => (
            <li>
              <a href={localizePath(key, locale)}>{t(`nav.${key}`)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-xl);
    background: var(--color-inverse-bg);
    color: var(--color-inverse-muted);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: var(--color-inverse-text);
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
    color: #fff;
  }
  .site-footer :focus-visible {
    outline-color: var(--color-inverse-text);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    padding-bottom: var(--space-xl);
  }
  .site-footer__brand p {
    margin-top: var(--space-xs);
  }
  .site-footer__agency span {
    color: var(--color-inverse-muted);
  }
  .site-footer__name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
  }
  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-inverse-muted);
    margin-bottom: var(--space-sm);
  }
  .site-footer__list,
  .site-footer__legal {
    list-style: none;
    padding: 0;
  }
  .site-footer__list li + li {
    margin-top: 0.4rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--text-xs);
  }
  .site-footer__legal {
    display: flex;
    gap: var(--space-md);
  }
</style>
