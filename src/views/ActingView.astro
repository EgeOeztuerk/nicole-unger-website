---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import FilmmakersEmbed from '../components/FilmmakersEmbed.astro';
import Gallery from '../components/Gallery.astro';
import VitaTables from '../components/VitaTables.astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getLocalized, getPage, getSettings } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { data } = await getPage('acting', 'schauspiel', locale);
const vita = await getLocalized('vita', locale);
const settings = await getSettings();
---

<BaseLayout title={data.title} description={data.description} locale={locale} current="acting" ogImage={data.gallery[0]?.image}>
  <PageIntro title={data.title} kicker={data.kicker} lead={data.intro} />

  <section class="section reels" aria-labelledby="reels-title">
    <div class="container">
      <h2 id="reels-title" class="visually-hidden">{data.reelsHeading}</h2>
      <ul class="reels__list">
        {
          data.reels.map((reel, i) => (
            <li class:list={['reels__item', { 'reels__item--featured': i === 0 }]}>
              <FilmmakersEmbed
                url={reel.url}
                title={reel.title}
                description={reel.description}
                language={reel.language}
                locale={locale}
                featured={i === 0}
                poster={reel.poster}
                posterAlt={reel.posterAlt}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head">
        <h2 id="gallery-title">{data.galleryHeading}</h2>
      </div>
      <Gallery items={data.gallery} locale={locale} label={data.galleryHeading} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="vita-title">
    <div class="container vita-layout">
      <div class="section-head">
        <h2 id="vita-title">{data.vitaHeading}</h2>
      </div>
      <VitaTables entries={vita} locale={locale} />
    </div>
  </section>

  <section class="section" id="buchung" aria-labelledby="booking-title">
    <div class="container booking">
      <div class="booking__main">
        <span class="kicker">{settings.agency.name}</span>
        <h2 id="booking-title">{data.booking.heading}</h2>
        <p>{data.booking.text}</p>
        {
          settings.agency.email && (
            <a class="button" href={`mailto:${settings.agency.email}`}>
              {data.booking.linkLabel}
            </a>
          )
        }
        <dl class="booking__contact">
          {
            settings.agency.email && (
              <div>
                <dt>{t('common.email')}</dt>
                <dd>
                  <a href={`mailto:${settings.agency.email}`}>{settings.agency.email}</a>
                </dd>
              </div>
            )
          }
          {
            settings.agency.phone && (
              <div>
                <dt>{t('common.phone')}</dt>
                <dd>
                  <a href={`tel:${settings.agency.phone.replace(/\s/g, '')}`}>{settings.agency.phone}</a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
      <div class="booking__profiles">
        <h3>{data.profilesHeading}</h3>
        <ul>
          {
            settings.profiles.map((p) => (
              <li>
                <a class="link-arrow" href={p.url} target="_blank" rel="noopener">
                  {p.label}
                  <span class="visually-hidden"> {t('common.externalLink')}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reels {
    padding-top: 0;
  }
  .reels__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 48em) {
    .reels__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .reels__item--featured {
      grid-column: 1 / -1;
    }
  }
  .booking {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) 0 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .booking__main {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    max-width: 34rem;
  }
  .booking__main .kicker {
    margin-bottom: 0;
  }
  .booking__contact {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }
  .booking__contact div {
    display: flex;
    gap: 0.6rem;
  }
  .booking__contact dt {
    min-width: 4.5rem;
    color: var(--color-text-muted);
  }
  .booking__profiles h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }
  .booking__profiles ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: var(--space-xs) var(--space-xl);
  }
  @media (min-width: 56em) {
    .booking {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
