---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import AudioLounge from '../components/AudioLounge.astro';
import FilmmakersEmbed from '../components/FilmmakersEmbed.astro';
import type { Locale } from '../i18n/config';
import { localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { getLocalized, getPage, getSettings, emailFor } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { data } = await getPage('voice', 'sprechen', locale);
const samples = await getLocalized('audio', locale);
const settings = await getSettings();
const mail = emailFor(settings, data.contact.emailKey);
---

<BaseLayout title={data.title} description={data.description} locale={locale} current="voice" ogImage={data.image?.image}>
  <PageIntro title={data.title} kicker={data.kicker} lead={data.intro} />

  {
    data.image && (
      <div class="container voice-visual">
        <Image
          src={data.image.image}
          alt={data.image.alt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 76rem) 76rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }

  <section class="section" aria-labelledby="lounge-title">
    <div class="container voice-layout">
      <div class="voice-layout__main">
        <div class="section-head">
          <h2 id="lounge-title">{data.loungeHeading}</h2>
          {data.loungeText && <p class="muted">{data.loungeText}</p>}
        </div>
        {
          data.reel && (
            <div class="voice-reel">
              <FilmmakersEmbed url={data.reel.url} title={data.reel.heading} description={data.reel.text} kind="audio" locale={locale} />
            </div>
          )
        }
        <AudioLounge samples={samples} locale={locale} headingId="lounge-title" />
      </div>

      <aside class="voice-layout__aside" aria-labelledby="traits-title">
        <h2 id="traits-title">{data.traitsHeading}</h2>
        <dl class="traits">
          {
            data.traits.map((trait) => (
              <div>
                <dt>{trait.label}</dt>
                <dd>{trait.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="voice-contact">
          <h3>{data.contact.heading}</h3>
          <p>{data.contact.text}</p>
          {mail && <a href={`mailto:${mail.address}`}>{mail.address}</a>}
          <a class="link-arrow" href={`${localizePath('about', locale)}?anliegen=sprechen#kontakt`}>{t('contact.toForm')}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .voice-visual :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }
  .voice-reel {
    margin-bottom: var(--space-xl);
  }
  .voice-layout {
    display: grid;
    gap: var(--space-2xl);
  }
  @media (min-width: 64em) {
    .voice-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-2xl);
    }
    .voice-layout__aside {
      padding-top: 0.4rem;
    }
  }
  .voice-layout__aside h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
  }
  .traits div {
    padding-block: var(--space-sm);
    border-top: var(--border);
  }
  .traits div:last-child {
    border-bottom: var(--border);
  }
  .traits dt {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .traits dd {
    margin-top: 0.15rem;
  }
  .voice-contact {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-surface-alt);
  }
  .voice-contact h3 {
    font-size: var(--text-lg);
  }
  .voice-contact p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
